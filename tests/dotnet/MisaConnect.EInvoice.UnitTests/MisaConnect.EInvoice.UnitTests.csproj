<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MisaConnect.EInvoice.UnitTests</RootNamespace>
    <AssemblyName>MisaConnect.EInvoice.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken): these tests drive deterministic
         fakes and some pin CancellationToken.None semantics on purpose. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\dotnet\MisaConnect.EInvoice.Application\MisaConnect.EInvoice.Application.csproj" />
    <ProjectReference Include="..\..\..\src\dotnet\MisaConnect.EInvoice.Domain\MisaConnect.EInvoice.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\dotnet\MisaConnect.EInvoice.Infrastructure\MisaConnect.EInvoice.Infrastructure.csproj" />
    <ProjectReference Include="..\MisaConnect.EInvoice.TestSupport\MisaConnect.EInvoice.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Delete\error-message-disambiguation.md">
      <LogicalName>MisaConnect.EInvoice.UnitTests.Delete.error-message-disambiguation.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Contracts\status-mapping.md">
      <LogicalName>MisaConnect.EInvoice.UnitTests.Contracts.status-mapping.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
