<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MisaConnect.EInvoice.IntegrationTests</RootNamespace>
    <AssemblyName>MisaConnect.EInvoice.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken): these tests drive deterministic
         fakes and some pin CancellationToken.None semantics on purpose. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\samples\dotnet\MisaConnect.Samples.Api\MisaConnect.Samples.Api.csproj" />
    <ProjectReference Include="..\..\..\src\dotnet\MisaConnect.EInvoice.Application\MisaConnect.EInvoice.Application.csproj" />
    <ProjectReference Include="..\..\..\src\dotnet\MisaConnect.EInvoice.Client\MisaConnect.EInvoice.Client.csproj" />
    <ProjectReference Include="..\..\..\src\dotnet\MisaConnect.EInvoice.Domain\MisaConnect.EInvoice.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\dotnet\MisaConnect.EInvoice.Infrastructure\MisaConnect.EInvoice.Infrastructure.csproj" />
    <ProjectReference Include="..\MisaConnect.EInvoice.TestSupport\MisaConnect.EInvoice.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
