<Project>

  <!--
    Target frameworks. The shipped libraries build for net8.0 and net10.0, and so do the unit tests
    and the test-support project, so both builds are tested. Integration tests (*.IntegrationTests)
    and samples (*.Samples.*) run on net10.0 (ASP.NET Core 10).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="!$(MSBuildProjectName.Contains('.Samples.')) And !$(MSBuildProjectName.EndsWith('.IntegrationTests'))">
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>MisaConnect Contributors</Authors>
    <Company>MisaConnect</Company>
    <Product>MisaConnect</Product>
    <Copyright>Copyright (c) MisaConnect Contributors</Copyright>
    <PackageProjectUrl>https://github.com/ChuKhaLi/MisaConnect</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ChuKhaLi/MisaConnect</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>misa;meinvoice;einvoice;vietnam;invoice;sdk</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
